{
  "expo": {
    "name": "CALMandi",
    "slug": "CALMandi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/calmandi_logo.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.calmandi.app"
    },
    "android": {
      "package": "com.calmandi.app",
      "adaptiveIcon": {
        "backgroundColor": "#16834A",
        "foregroundImage": "./assets/calmandi_logo.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "f2daa4b5-705f-41fe-9b56-ce2ee2a6c173"
      }
    },
    "owner": "bhakthi_md"
  }
}
